# =================================
# NotaZip - Environment Variables
# =================================

# --- API Gateway ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth MS (port 3004) ---
SESSION_SECRET=your-session-secret-here
JWT_SECRET=your-jwt-secret-here

# --- Database (shared by all backend services) ---
DATABASE_URL=postgresql://nota_zip:changeme@localhost:5432/nota_zip

# --- Redis (message-control-ms) ---
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- WhatsApp Adapter ---
WHATSAPP_API_URL=http://localhost:3006
WHATSAPP_API_KEY=your-whatsapp-api-key

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@notazip.com.br
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=NotaZip <noreply@notazip.com.br>

# --- Error Tracking ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# --- Logging ---
LOG_LEVEL=info

# --- Service Ports ---
GATEWAY_PORT=3001
USER_MS_PORT=3002
AUTH_MS_PORT=3004
MESSAGE_CONTROL_MS_PORT=3005
WHATSAPP_ADP_PORT=3006
OCR_ADP_PORT=3007
LLM_ADP_PORT=3008
NOTE_GUARD_MS_PORT=3011
FRONTEND_PORT=3000
